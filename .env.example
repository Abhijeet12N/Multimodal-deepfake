# ==========================================
# Multimodal Deepfake Detection Studio - Env
# ==========================================

# Model Checkpoints
MODEL_PATH=models/best_model.pt
# Audio UI uses official AASIST by default. Point this to your local AASIST.pth.
AUDIO_DETECTOR=aasist
AASIST_CHECKPOINT_PATH=../aasist/models/weights/AASIST.pth
# To use the older standalone Wav2Vec classifier instead:
# AUDIO_DETECTOR=legacy_wav2vec_mlp
# AUDIO_MODEL_PATH=models/audio_model.pt
AUDIO_DEVICE=cpu

# Web Interface Server Options
FLASK_HOST=127.0.0.1
FLASK_PORT=5000

# Training Pipeline Paths (For FakeAVCeleb v1.2)
DATASET_ROOT=D:/data/FakeAVCeleb_v1.2/FakeAVCeleb_v1.2
WORK_DIR=D:/deepfake-work
